# CS 3660 Sprint 2 — Fleet Monitor environment variables
# Copy to .env and fill in real values. Never commit .env.

# MQTT broker
MQTT_URL=mqtt://mqtt.uvucs.org:1883
MQTT_USER=
MQTT_PASS=

# Auth token for POST /api/command (ACK / RESOLVE)
AUTH_TOKEN=changeme

# SQLite event store path (use :memory: for tests)
SQLITE_PATH=./data/events.db

# ws-bridge HTTP port
WS_BRIDGE_PORT=3000

# Alert engine tuning
SUSTAINED_READINGS=3
STALENESS_MS=30000
